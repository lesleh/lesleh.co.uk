# Copy this file to .env for local development. Set the same variables in Vercel.

# Access key for an IAM user that is only allowed the ses:SendEmail action.
# Vercel reserves the AWS_ names, so these start with SES_.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# AWS region of the Amazon SES identity, for example eu-west-2.
SES_REGION=

# Sender address. It must be a verified identity in Amazon SES, or on a verified domain.
CONTACT_FROM_EMAIL=

# Address that receives the messages from the contact form.
# While the SES account is in the sandbox, this address must be verified too.
CONTACT_TO_EMAIL=
