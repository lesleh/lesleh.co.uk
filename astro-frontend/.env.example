# Copy this file to .env for local development. Set the same variables in Vercel.

# API key from https://resend.com/api-keys. "Sending access" is enough.
RESEND_API_KEY=

# Sender address. It must be on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=

# Address that receives the messages from the contact form.
CONTACT_TO_EMAIL=
