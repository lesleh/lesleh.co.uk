---
import { Image } from "astro:assets";
import MainLayout from "../layouts/main.astro";

const photos = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../content/photos/*.jpg", {
    eager: true,
  }),
).map((photo) => photo.default);
---

<MainLayout title="Photos">
  <div
    class="grid grid-flow-dense grid-cols-[repeat(auto-fill,minmax(120px,1fr))] gap-3.75"
  >
    {
      photos.map((photo, i) => (
        <a
          href="#"
          class="block h-auto w-full focus:shadow-[0_0_0_3px_white] focus:outline-none"
        >
          <Image
            class="block h-auto w-full"
            src={photo}
            width={145 * 2}
            height={145 * 2}
            loading={i < 8 ? "eager" : "lazy"}
            alt=""
          />
        </a>
      ))
    }
  </div>
</MainLayout>
