---
import MainLayout from "../layouts/main.astro";
import PostDate from "../components/post-date.astro";
import DraftBadge from "../components/draft-badge.astro";
import { getPosts } from "../lib/posts";
import { getIllustration } from "../lib/illustrations";

const posts = (await getPosts()).map((post) => ({
  post,
  Illustration: getIllustration(post),
}));

// Each card sits at a slight angle, like paper pinned to a board.
const tilts = [
  "-rotate-[1.2deg]",
  "rotate-[0.9deg]",
  "-rotate-[0.6deg]",
  "rotate-[1.3deg]",
  "-rotate-1",
];

const otherSites = [
  {
    name: "Playground",
    url: "https://lesleh.uk/",
    summary: "Games, simulations and small AI things that run in the browser.",
  },
  {
    name: "Recipes",
    url: "https://recipes.lesleh.co.uk/",
    summary: "The recipes I cook, mostly quick weeknight dinners.",
  },
];
---

<MainLayout title="Home">
  <section aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="sr-only">Posts</h2>
    <ul
      class="m-0 grid list-none grid-cols-1 gap-x-8 gap-y-10 px-1.5 pt-3.5 pb-2 lg:grid-cols-2"
    >
      {
        posts.map(({ post, Illustration }, index) => (
          <li class:list={[index === 0 && "lg:col-span-2"]}>
            <article
              class:list={[
                "relative h-full rounded bg-(--illo-paper) p-3.5 pb-5.5 text-(--illo-ink)",
                "shadow-[inset_0_1px_0_light-dark(transparent,rgb(255_255_255/0.06)),0_10px_22px_light-dark(rgb(59_13_26/0.35),rgb(0_0_0/0.6))]",
                "before:absolute before:-top-3 before:left-1/2 before:h-6.5 before:w-28 before:-translate-x-1/2 before:-rotate-3 before:bg-tape before:content-['']",
                tilts[index % tilts.length],
                index === 0 &&
                  "lg:grid lg:grid-cols-[1.2fr_1fr] lg:items-center lg:gap-5.5",
              ]}
            >
              {Illustration && (
                <a href={`/blog/${post.id}/`} aria-hidden="true" tabindex="-1">
                  <Illustration class="m-0! aspect-video h-auto w-full p-0!" />
                </a>
              )}
              <div>
                <h3
                  class:list={[
                    "mt-2.5 leading-snug font-bold text-(--illo-accent)",
                    index === 0 ? "text-[1.45em] lg:mt-0 lg:text-[1.8em]" : "text-[1.25em]",
                  ]}
                >
                  <a class="underline" href={`/blog/${post.id}/`}>
                    {post.data.title}
                  </a>
                </h3>
                <p class="mt-1 flex items-center gap-3">
                  <PostDate
                    date={post.data.date}
                    class="text-[0.875em] opacity-85"
                  />
                  {post.data.draft && <DraftBadge />}
                </p>
                {post.data.description && (
                  <p class="mt-1.5 text-[0.9em]">{post.data.description}</p>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    aria-labelledby="elsewhere-heading"
    class="mt-10 border-t border-primary-inverse/30 pt-6"
  >
    <h2 id="elsewhere-heading" class="text-[1.35em] font-light text-accent">Elsewhere</h2>
    <ul class="m-0 mt-3 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
      {
        otherSites.map((site) => (
          <li>
            <a class="text-accent underline" href={site.url}>
              {site.name}
            </a>
            <p class="mt-1 text-[0.875em]">{site.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>
