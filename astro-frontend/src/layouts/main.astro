---
import "../stylesheets/global.css";
import Nav from "../components/nav";
import Header from "../components/header";
import Icon from "../components/icon";
import { faGithubAlt } from "@fortawesome/free-brands-svg-icons";
import { faCircleHalfStroke } from "@fortawesome/free-solid-svg-icons";

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<html lang="en" class="bg-primary font-sans text-primary-inverse">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - Lesleh.co.uk</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Runs before the first paint so a saved theme does not flash.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        // Storage is blocked, so the site follows the browser's preference.
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="m-2 px-gutter text-body">
    <div
      class="mx-auto grid max-w-[60em] grid-cols-1 gap-2.5 sm:grid-cols-[1fr_3fr] sm:gap-x-7.5"
    >
      <Header client:idle />
      <Nav />

      <div
        class="flex items-center justify-between gap-4 sm:col-start-2 sm:row-start-1"
      >
        <h1 class="text-title font-light">{title}</h1>
        <button
          id="theme-toggle"
          type="button"
          class="cursor-pointer border-0 bg-transparent p-0 text-[1.5rem] text-primary-inverse opacity-75 hover:opacity-100 focus:opacity-100"
          hidden
        >
          <Icon icon={faCircleHalfStroke} />
        </button>
      </div>
      <main class="overflow-x-auto sm:col-start-2 sm:row-span-2 sm:row-start-2">
        <slot />
      </main>
      <footer class="text-center sm:col-start-2 sm:row-start-4">
        <a
          class="text-[1.5rem] text-primary-inverse opacity-75 hover:opacity-100 focus:opacity-100"
          href="https://github.com/lesleh/lesleh.co.uk/"
          title="View source on GitHub"
        >
          <Icon icon={faGithubAlt} />
        </a>
      </footer>
    </div>

    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz@6..12&display=swap"
      rel="stylesheet"
    />
  </body>
</html>

<script>
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");

  const currentTheme = () =>
    root.dataset.theme ??
    (window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light");

  const otherTheme = () => (currentTheme() === "dark" ? "light" : "dark");

  const updateLabel = () => {
    const label = `Switch to ${otherTheme()} theme`;
    button?.setAttribute("aria-label", label);
    button?.setAttribute("title", label);
  };

  button?.addEventListener("click", () => {
    const theme = otherTheme();
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {
      // Storage is blocked, so the choice lasts for this page only.
    }
    updateLabel();
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", updateLabel);

  updateLabel();
  button?.removeAttribute("hidden");
</script>
