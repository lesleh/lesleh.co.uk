---
import "../stylesheets/global.css";
import { Font, getImage } from "astro:assets";
import defaultImage from "../assets/leslie.png";
import Nav from "../components/nav";
import Header from "../components/header";
import Icon from "../components/icon";
import { faGithubAlt } from "@fortawesome/free-brands-svg-icons";
import { faCircleHalfStroke } from "@fortawesome/free-solid-svg-icons";

export interface Props {
  title: string;
  description?: string | undefined;
  image?: ImageMetadata | undefined;
  type?: "website" | "article";
}

const SITE_NAME = "Lesleh.co.uk";
const DEFAULT_DESCRIPTION =
  "Leslie Hoare's personal site, with posts about things I've been tinkering with.";

const { title, description, image, type = "website" } = Astro.props;

// The 404 page answers for every missing address, so it has no address of its own.
const isNotFound = Astro.url.pathname.startsWith("/404");
const canonical = new URL(Astro.url.pathname, Astro.site);
// A post's image is wide, so it gets the large card. The default is a square photo.
const preview = await getImage({ src: image ?? defaultImage, format: "png" });
const previewUrl = new URL(preview.src, Astro.site);
---

<html lang="en" class="bg-primary font-sans text-primary-inverse">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />
    <title>{title} - {SITE_NAME}</title>
    <meta name="description" content={description ?? DEFAULT_DESCRIPTION} />
    {isNotFound || <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description ?? DEFAULT_DESCRIPTION}
    />
    {isNotFound || <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content={preview.attributes.width} />
    <meta property="og:image:height" content={preview.attributes.height} />
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <script is:inline>
      // Runs before the first paint so a saved theme does not flash.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        // Storage is blocked, so the site follows the browser's preference.
      }
    </script>
    <Font
      cssVariable="--font-nunito-sans"
      preload={[{ style: "normal" }]}
    />
    {
      // Vercel serves this script, so it only exists on a deployed build.
      import.meta.env.PROD && (
        <script is:inline defer src="/_vercel/insights/script.js" />
      )
    }
  </head>
  <body class="m-2 px-gutter text-body">
    <a
      href="#main"
      class="sr-only rounded-sm bg-primary-inverse px-4 py-2 font-semibold text-primary no-underline focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-10 focus:outline-2 focus:outline-offset-2 focus:outline-primary-inverse"
    >
      Skip to main content
    </a>
    <div
      class="mx-auto grid max-w-[60em] grid-cols-1 gap-2.5 sm:grid-cols-[1fr_3fr] sm:gap-x-7.5"
    >
      <Header client:idle />
      <Nav currentPath={Astro.url.pathname} />

      <div
        class="flex items-center justify-between gap-4 sm:col-start-2 sm:row-start-1"
      >
        <h1 class="text-title font-light">{title}</h1>
        <button
          id="theme-toggle"
          type="button"
          class="cursor-pointer border-0 bg-transparent p-0 text-[1.5rem] text-primary-inverse opacity-75 hover:opacity-100 focus:opacity-100"
          hidden
        >
          <Icon icon={faCircleHalfStroke} />
        </button>
      </div>
      <main
        id="main"
        tabindex="-1"
        class="overflow-x-auto outline-none sm:col-start-2 sm:row-span-2 sm:row-start-2">
        <slot />
      </main>
      <footer class="text-center sm:col-start-2 sm:row-start-4">
        <a
          class="text-[1.5rem] text-primary-inverse opacity-75 hover:opacity-100 focus:opacity-100"
          href="https://github.com/lesleh/lesleh.co.uk/"
          title="View source on GitHub"
        >
          <Icon icon={faGithubAlt} />
        </a>
      </footer>
    </div>
  </body>
</html>

<script>
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");

  const currentTheme = () =>
    root.dataset.theme ??
    (window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light");

  const otherTheme = () => (currentTheme() === "dark" ? "light" : "dark");

  const updateLabel = () => {
    const label = `Switch to ${otherTheme()} theme`;
    button?.setAttribute("aria-label", label);
    button?.setAttribute("title", label);
  };

  button?.addEventListener("click", () => {
    const theme = otherTheme();
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {
      // Storage is blocked, so the choice lasts for this page only.
    }
    updateLabel();
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", updateLabel);

  updateLabel();
  button?.removeAttribute("hidden");
</script>
